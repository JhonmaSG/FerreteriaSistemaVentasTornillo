# =====================================================================
# Plantilla de variables de entorno para Ferreteria Tornillo
#
# Copia este archivo a ".env" y completa los valores:
#     cp .env.example .env
#
# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).
# =====================================================================

# --- Base de datos ---
DB_NAME=bd_ventas
DB_USERNAME=postgres
# OBLIGATORIA. Docker compose falla de inmediato si no esta definida.
DB_PASSWORD=

# --- JWT ---
# OBLIGATORIA. Minimo 48 caracteres (algoritmo HS384).
# Genera una con: openssl rand -base64 48
JWT_SECRET=
# Duracion del token en milisegundos (86400000 = 24 horas).
JWT_EXPIRATION=86400000

# --- Usuario administrador inicial ---
# OBLIGATORIA. El DataLoader crea este usuario en el primer arranque.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Exposicion ---
# Puerto del host donde se publica la API.
APP_PORT=8080
